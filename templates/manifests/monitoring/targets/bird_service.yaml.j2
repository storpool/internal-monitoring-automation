{% for host in (groups['routers'] | default([])) %}
- targets:
    - {{ hostvars[host]['ansible_host'] }}:9324
  labels:
    instance: {{ host }}
{# The routers group has no is_virtual test, so it also holds router VMs. NetBox only gives a VM
   a site when its cluster is assigned to one, so site cannot be assumed here. #}
    type: {{ 'virtual-machine' if hostvars[host]['is_virtual'] | default(false) else 'bare-metal' }}
    location: {{ hostvars[host]['site'] | default(hostvars[host]['location'] | default('undefined')) }}
    environment: production
{% endfor %}
